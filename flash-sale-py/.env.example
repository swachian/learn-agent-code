# ============================================
# Environment Configuration
# ============================================

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=1000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=flash-sale-orders
KAFKA_CONSUMER_GROUP=flash-sale-consumer

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flashsale

# Business Config
TOTAL_STOCK=10000
STOCK_SHARDS=100
GLOBAL_QPS=1000000
USER_QPS=100

# Logging
LOG_LEVEL=INFO